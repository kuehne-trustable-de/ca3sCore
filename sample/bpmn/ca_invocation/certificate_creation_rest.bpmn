    <bpmn2:scriptTask id="Activity_0gc22sn" name="RetrieveJWTFromCache" scriptFormat="groovy">
      <bpmn2:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="jwt">${jwt}</camunda:outputParameter>
          <camunda:outputParameter name="authTokenStatus">${200}</camunda:outputParameter>
        </camunda:inputOutput>
