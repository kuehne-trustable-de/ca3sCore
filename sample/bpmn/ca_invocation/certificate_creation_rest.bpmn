    <bpmn2:scriptTask id="Activity_1avbwab" name="RevokeCertificate" scriptFormat="groovy">
      <bpmn2:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="targetUrl">${processAttribute_targetUrl}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_0xhnau3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_174fal5</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics>
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
      </bpmn2:multiInstanceLoopCharacteristics>
      <bpmn2:script>
        import com.fasterxml.jackson.databind.ObjectMapper
        import de.trustable.ca3s.core.service.dto.NamedValue
        import org.slf4j.*
        import org.springframework.security.authentication.UsernamePasswordAuthenticationToken
        import org.springframework.security.core.context.SecurityContext
        import org.springframework.security.core.context.SecurityContextHolder

        Logger logger = LoggerFactory.getLogger("de.trustable.ca3s.bpmn.certificateCreation.retrieveCsr")

        execution.setVariable("status", "NotFound");
        String payload = ""

        logger.info("###### targetUrl: {}", targetUrl)
        logger.info("jwt: {}", jwt)
        logger.info("certificate: {}", certificate.getId())

        if( certificate != null ){
            if( certificate.isActive()){
                SecurityContext securityContext = SecurityContextHolder.getContext()
                if( securityContext.getAuthentication() == null){
                  logger.info("Setting fallback user to 'system' ")
                  securityContext.setAuthentication( new UsernamePasswordAuthenticationToken("system", "system"))
                }

                String reason = "UNUSED"
                if("keyCompromise".equals(revocationReason)){
                  reason = "KEY_COMPROMISE"
                }else if("affiliationChanged".equals(revocationReason)){
                  reason = "AFFILIATION_CHANGED"
                }else if("superseded".equals(revocationReason)){
                  reason = "SUPERSEDED"
                }else if("cessationOfOperation".equals(revocationReason)){
                  reason = "CESSATION_OF_OPERATION"
                }

                Map&lt;String, Object&gt; params = new HashMap&lt;&gt;();
                params.put("serialNumber", certificate.getSerialAsHex())
                params.put("revocationReason", reason)
                params.put("issuerName", certificate.getIssuer() );
//                params.put("revocationRequestor", securityContext.getAuthentication().getName() );

                HashMap[] paramArr = new HashMap[1]
                paramArr[0] = params
                payload = new ObjectMapper().writeValueAsString(paramArr)
                execution.setVariable("status", "Success")

                logger.info( "payload: {}", payload)
            }else{
                logger.info( "certificate #{} not active", certificate.isActive())
                execution.setVariable("status", "NotActive")
            }
        }

        execution.setVariable("payload", payload);
      </bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:serviceTask id="Activity_0ynhmko" name="RestInvocationRevoke">
      <bpmn2:extensionElements>
        <camunda:connector>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">${processAttribute_targetUrl}v2/revoke</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="CONTENT-TYPE">application/json</camunda:entry>
                <camunda:entry key="Authorization">Bearer ${jwt}</camunda:entry>
                <camunda:entry key="accept-encoding">gzip;q=0,deflate,identity</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">${payload}</camunda:inputParameter>
            <camunda:outputParameter name="status">
              <camunda:script scriptFormat="groovy">statusCode == 200 ? "Success" : "Failed"</camunda:script>
            </camunda:outputParameter>
            <camunda:outputParameter name="statusCode">${statusCode}</camunda:outputParameter>
            <camunda:outputParameter name="revokeResponse">${(statusCode==204)?"":response}</camunda:outputParameter>
          </camunda:inputOutput>
          <camunda:connectorId>http-connector</camunda:connectorId>
        </camunda:connector>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_174fal5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0s65cvy</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:scriptTask id="Activity_1fn7zua" name="HandleRevocationResponse" scriptFormat="groovy">
      <bpmn2:incoming>Flow_0s65cvy</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0nkju8q</bpmn2:outgoing>
      <bpmn2:script>
        import de.trustable.ca3s.core.domain.Certificate
        import org.slf4j.*
        import org.camunda.spin.json.*
        import static org.camunda.spin.Spin.JSON

        Logger logger = LoggerFactory.getLogger("de.trustable.ca3s.bpmn.certificateCreation.HandleRevocationResponse")
        logger.info( "revocation url: {}", processAttribute_targetUrl + "v2/revoke")
        logger.info( "statusCode: {}, status: {}", statusCode, status)
        logger.info( "revokeResponse: {}", revokeResponse)

        String revocationStatus = "Failure"
        String errorMessage = ""

        if(statusCode == 204){
          revocationStatus = "Revoked"

        }else if( (statusCode == 400) || (statusCode == 401) || (statusCode == 404) || (statusCode == 500)){

          SpinJsonNode jsonRoot = JSON(revokeResponse)
          errorMessage += "Status:" + status + "\n"

          SpinJsonNode jsonNodeErrorMessages = jsonRoot.prop("errorMessages")
          if( jsonNodeErrorMessages.isArray() ){
            for(SpinJsonNode jsonNodeErrorMessage: jsonNodeErrorMessages.elements()){
              errorMessage += jsonNodeErrorMessage.stringValue() + "\n"
            }
          }
        }

        execution.setVariable("issueResponse", "dropped content")
        execution.setVariable("failureReason", errorMessage);
        execution.setVariable("status", revocationStatus);
      </bpmn2:script>
    </bpmn2:scriptTask>
