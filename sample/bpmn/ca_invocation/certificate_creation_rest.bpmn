    <bpmn2:scriptTask id="Activity_0q32c21" name="HandleIssueResponse" scriptFormat="groovy">
      <bpmn2:incoming>Flow_10pvgz6</bpmn2:incoming>
      <bpmn2:outgoing>Flow_17h4sim</bpmn2:outgoing>
      <bpmn2:script>
        import de.trustable.ca3s.core.domain.Certificate
        import org.apache.commons.codec.binary.Base64
        import org.slf4j.*
        import org.camunda.spin.json.*
        import static org.camunda.spin.Spin.JSON

        Logger logger = LoggerFactory.getLogger("de.trustable.ca3s.bpmn.certificateCreation.HandleResponse")
        logger.info( "statusCode: {}, status: {}", statusCode, status)
        logger.info( "issueResponse: {}", issueResponse)

        Certificate certificate = null
        String creationStatus = "Failure"
        String errorMessage = ""

        SpinJsonNode jsonRoot = JSON(issueResponse)
        if(statusCode == 200){
          String certificateStatus = jsonRoot.prop("status").stringValue()
          SpinJsonNode jsonNodeCertificate = jsonRoot.prop("certificate")
          String certificateBase64 = jsonNodeCertificate.prop("certificate").stringValue()

          logger.info( "certificateStatus: {}", certificateStatus)
          logger.info( "certificateBase64: {}", certificateBase64)

          SpinJsonNode jsonNodeCertificateChainArr = jsonRoot.prop("certificateChain")
          if( jsonNodeCertificateChainArr.isArray() ){
            for(SpinJsonNode jsonNodeChainCertificateBase64: jsonNodeCertificateChainArr.elements()){
              String chainCertificateBase64 = jsonNodeChainCertificateBase64.stringValue()
              logger.info( "chainCertificateBase64: {}", chainCertificateBase64)
              certificateUtil.createCertificate(Base64.decodeBase64(chainCertificateBase64), null, null, false, "SwissSign REST chain interface")
            }
          }

          logger.info( "(re-)create target certificate")
          certificate = certificateUtil.createCertificate(Base64.decodeBase64(certificateBase64), null, null, false, "SwissSign REST interface request")
          logger.info( "certificate created: {}", certificate)

          execution.setVariable("certificate", certificate)
          execution.setVariable("issueResponse", "dropped content")

          creationStatus = "Created"

        }else if( (statusCode == 400) || (statusCode == 401) || (statusCode == 404) || (statusCode == 500)){

          errorMessage += "Status:" + status + "\n"

          SpinJsonNode jsonNodeErrorMessages = jsonRoot.prop("errorMessages")
          if( jsonNodeErrorMessages.isArray() ){
            for(SpinJsonNode jsonNodeErrorMessage: jsonNodeErrorMessages.elements()){
              errorMessage += jsonNodeErrorMessage.stringValue() + "\n"
            }
          }
        }

        execution.setVariable("issueResponse", "dropped content")
        execution.setVariable("failureReason", errorMessage);
        execution.setVariable("status", creationStatus);
      </bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:sequenceFlow id="Flow_17h4sim" sourceRef="Activity_0q32c21" targetRef="EndEvent_1" />
