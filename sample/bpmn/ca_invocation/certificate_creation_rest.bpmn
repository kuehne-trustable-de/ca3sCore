    <bpmn2:scriptTask id="Activity_109i6e1" name="StoreJWTToCache" scriptFormat="groovy">
      <bpmn2:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="jwt">${jwt}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_16oe7vp</bpmn2:incoming>
      <bpmn2:incoming>Flow_1g2wim9</bpmn2:incoming>
      <bpmn2:outgoing>Flow_0atv8er</bpmn2:outgoing>
      <bpmn2:script>
        import org.slf4j.*

        Logger logger = LoggerFactory.getLogger("de.trustable.ca3s.bpmn.certificateCreation.StoreJWTToCache")

        String key = processAttribute_targetUrl + "|" + processAttribute_userName + "|" + processAttribute_api_key
        jwtCache.putJwt(key, jwt)
        logger.info( "storing jwt in cache : {}", jwt)
      </bpmn2:script>
    </bpmn2:scriptTask>
