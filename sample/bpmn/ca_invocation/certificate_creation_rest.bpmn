      <bpmn2:incoming>SequenceFlow_1b8to73</bpmn2:incoming>
      <bpmn2:outgoing>Flow_1tkzfvt</bpmn2:outgoing>
      <bpmn2:script>
        import org.slf4j.*

        Logger logger = LoggerFactory.getLogger("de.trustable.ca3s.bpmn.certificateCreation.RetrieveJWTFromCache")

        String key = processAttribute_targetUrl + "|" + processAttribute_userName + "|" + processAttribute_api_key
        String jwt = ""
        if( jwtCache.getJwt(key).isPresent() ){
          jwt = jwtCache.getJwt(key).get()
          logger.info( "jwt from cache : {}", jwt)
        }else{
          logger.info( "jwt missing in cache")
        }
        execution.setVariable("jwt", jwt);
      </bpmn2:script>
    </bpmn2:scriptTask>
